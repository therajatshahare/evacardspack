<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="135"
                android:endColor="#40334155"
                android:startColor="#601E293B" />
            <stroke android:width="3dp" android:color="#FF3B82F6" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="135"
                android:endColor="#201E293B"
                android:startColor="#300F172A" />
            <stroke android:width="1dp" android:color="#30FFFFFF" />
        </shape>
    </item>
</selector>
