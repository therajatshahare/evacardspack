<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="System Monitor"
        android:src="@drawable/ic_storage_banner" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="System Monitor"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ramStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="RAM: 62% Used (1.2 GB / 2.0 GB)"
        android:textColor="#8B5CF6"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/storageStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Storage: 45% Used (14.4 GB / 32.0 GB)"
        android:textColor="#94A3B8"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btnBoostMemory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="#8B5CF6"
        android:focusable="true"
        android:paddingHorizontal="28dp"
        android:paddingVertical="12dp"
        android:text="⚡ Boost Memory"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>
