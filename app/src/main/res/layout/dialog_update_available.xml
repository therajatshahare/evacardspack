<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="480dp"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_card_selector"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Update"
            android:src="@drawable/ic_weather_banner" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/updateDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Update Available!"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/updateVersionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Version v1.4.0 is ready for install"
                android:textColor="#3B82F6"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="#30FFFFFF" />

    <TextView
        android:id="@+id/updateChangelogText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Changelog: Improved performance, glass UI effects, and bug fixes."
        android:textColor="#94A3B8"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnLater"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:backgroundTint="#334155"
            android:focusable="true"
            android:text="Later"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnUpdateNow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#3B82F6"
            android:focusable="true"
            android:text="⚡ Update Now"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
