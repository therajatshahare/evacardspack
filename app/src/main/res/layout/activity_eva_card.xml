<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Eva Cards Pack Dashboard"
        android:textColor="#F8FAFC"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Use TV Remote D-Pad (Left/Right) to navigate. Press OK on System Monitor to Boost RAM."
        android:textColor="#94A3B8"
        android:textSize="16sp" />

    <!-- Cards Row (4 Columns) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Weather Card Panel -->
        <LinearLayout
            android:id="@+id/panelWeatherCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/glass_card_selector"
            android:clickable="true"
            android:descendantFocusability="blocksDescendants"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusLeft="@+id/panelWeatherCard"
            android:nextFocusRight="@+id/panelClockCard"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Weather"
                android:src="@drawable/ic_weather_banner" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Weather Live"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="26°C Sunny · Nagpur"
                android:textColor="#3B82F6"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Humidity: 45% · Wind: 12 km/h"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Minimal Clock Card Panel -->
        <LinearLayout
            android:id="@+id/panelClockCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/glass_card_selector"
            android:clickable="true"
            android:descendantFocusability="blocksDescendants"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusLeft="@+id/panelWeatherCard"
            android:nextFocusRight="@+id/panelTrendingCard"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Clock"
                android:src="@drawable/ic_clock_banner" />

            <TextView
                android:id="@+id/clockTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="07:30 PM"
                android:textColor="#4ADE80"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/clockDateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Thursday, 5 November"
                android:textColor="#94A3B8"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Timezone: Asia/Kolkata"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Trending Card Panel -->
        <LinearLayout
            android:id="@+id/panelTrendingCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/glass_card_selector"
            android:clickable="true"
            android:descendantFocusability="blocksDescendants"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusLeft="@+id/panelClockCard"
            android:nextFocusRight="@+id/panelSystemMonitorCard"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Trending"
                android:src="@drawable/ic_trending_banner" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Trending"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Top Pick: Interstellar"
                android:textColor="#EAB308"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Rating: ⭐ 8.7/10 · Sci-Fi"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- System Monitor Card Panel -->
        <LinearLayout
            android:id="@+id/panelSystemMonitorCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/glass_card_selector"
            android:clickable="true"
            android:descendantFocusability="blocksDescendants"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusLeft="@+id/panelTrendingCard"
            android:nextFocusRight="@+id/panelSystemMonitorCard"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="System Monitor"
                android:src="@drawable/ic_storage_banner" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="System Monitor"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dashboardRamText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="RAM: 62% Used"
                android:textColor="#8B5CF6"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/dashboardStorageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Storage: 45% Used"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="⚡ Click OK to Boost RAM"
                android:textColor="#8B5CF6"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
