<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="Minimal Clock">

        <activity
            android:name=".clock.ClockCardActivity"
            android:exported="true"
            android:icon="@drawable/ic_clock_banner"
            android:label="Minimal Clock">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="io.rns.evalauncher.category.DOCK_CARD" />
            </intent-filter>
            <meta-data
                android:name="io.rns.evalauncher.card"
                android:resource="@xml/card_clock_spec" />
        </activity>

    </application>

</manifest>
